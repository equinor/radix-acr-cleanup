	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/cmd/acr-cleanup/main.go",
			"env": {},
			"args": [
				"--period=10s",
				"--registry=radixdev",
				"--subscription-id=16ede44b-1f74-40a5-b428-46cca9a5741b",
				"--cluster-type=development",
				"--current-cluster-name=weekly-40",
				"--active-cluster-name=weekly-41",
				"--delete-untagged=false",
				"--retain-latest-untagged=5",
				"--perform-delete=false",
				"--cleanup-days=su,mo,tu,we,th,fr,sa",
				"--cleanup-start=0:00",
				"--cleanup-end=23:00",
				"--log-level=debug",
				"--pretty-print=true"
			]
		}
	]
}
